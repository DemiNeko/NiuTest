{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NiuTest exam v1",
  "description": "Canonical exchange format. The importer also checks index bounds against options, duplicate IDs and duplicate answer text.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "sourceName": { "type": "string", "maxLength": 200 },
    "answerKey": { "type": "string", "maxLength": 200 },
    "language": { "type": "string", "maxLength": 200 },
    "sections": { "type": "object", "propertyNames": { "$ref": "#/$defs/sectionId" }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "questions": { "type": "array", "minItems": 1, "maxItems": 5000, "items": { "$ref": "#/$defs/question" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$", "not": { "enum": ["constructor", "prototype", "__proto__"] } },
    "sectionId": { "allOf": [{ "$ref": "#/$defs/id" }, { "not": { "const": "all" } }] },
    "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "question": {
      "type": "object",
      "required": ["id", "question", "options", "correctIndex", "answerStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "section": { "$ref": "#/$defs/sectionId" },
        "number": { "type": "integer", "minimum": 1 },
        "question": { "$ref": "#/$defs/text" },
        "options": { "type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "correctIndex": { "type": ["integer", "null"], "minimum": 0, "maximum": 11 },
        "answerStatus": { "enum": ["provided", "verified", "inferred", "needs-review"] },
        "explanation": { "type": "string", "maxLength": 20000 },
        "note": { "type": "string", "maxLength": 20000 },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }
      },
      "allOf": [
        { "if": { "properties": { "correctIndex": { "type": "null" } }, "required": ["correctIndex"] }, "then": { "properties": { "answerStatus": { "const": "needs-review" } } } },
        { "if": { "properties": { "answerStatus": { "const": "verified" } }, "required": ["answerStatus"] }, "then": { "required": ["sourceUrl"], "properties": { "correctIndex": { "type": "integer" } } } }
      ]
    }
  }
}
